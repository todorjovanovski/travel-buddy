<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelBuddy.Views"
             xmlns:dtOs="clr-namespace:TravelBuddy.Models.DTOs"
             x:Class="TravelBuddy.Views.TripRequestsView"
             x:Name="ThisView">
    
    <Border
        StrokeShape="RoundRectangle 20"
        Padding="10">
        <CollectionView
            ItemsSource="{Binding TripRequests, Source={x:Reference ThisView}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtOs:UserTripRequest">
                    <views:TripRequestView
                        UserTripRequest="{Binding .}"
                        AcceptTripRequestCommand="{Binding AcceptTripRequestCommand, Source={x:Reference ThisView}}"
                        RejectTripRequestCommand="{Binding RejectTripRequestCommand, Source={x:Reference ThisView}}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Border>
    
</ContentView>