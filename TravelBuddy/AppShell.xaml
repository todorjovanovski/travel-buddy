<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelBuddy.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TravelBuddy.Pages"
    FlyoutBehavior="Disabled"
    Title="TravelBuddy"
    NavBarIsVisible="False"
    TabBarTitleColor="{StaticResource Primary}"
    TabBarForegroundColor="{StaticResource Primary}">
    
    <TabBar>
        <ShellContent
            Title="Trips"
            Icon="trips"
            ContentTemplate="{DataTemplate pages:TripsPage}"
            Route="TripsPage"/>
        <ShellContent
            x:Name="Home"
            Icon="home"
            Title="Home"
            ContentTemplate="{DataTemplate pages:HomePage}"
            Route="HomePage"/>
        <ShellContent
            Title="Profile"
            Icon="profile"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage"/>
    </TabBar>

</Shell>
